<svg width="800" height="400" viewBox="0 0 800 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10b981;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#06b6d4;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="people" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#f0f0f0;stop-opacity:0.8" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="400" fill="url(#bg)"/>
  
  <!-- Team elements -->
  <circle cx="150" cy="120" r="30" fill="url(#people)" opacity="0.8"/>
  <text x="150" y="130" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#10b981">👨‍💻</text>
  
  <circle cx="250" cy="100" r="30" fill="url(#people)" opacity="0.8"/>
  <text x="250" y="110" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#10b981">👩‍💻</text>
  
  <circle cx="550" cy="110" r="30" fill="url(#people)" opacity="0.8"/>
  <text x="550" y="120" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#10b981">👨‍💻</text>
  
  <circle cx="650" cy="130" r="30" fill="url(#people)" opacity="0.8"/>
  <text x="650" y="140" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#10b981">👩‍💻</text>
  
  <!-- Connection lines -->
  <line x1="180" y1="120" x2="220" y2="100" stroke="white" stroke-width="2" opacity="0.6"/>
  <line x1="280" y1="100" x2="520" y2="110" stroke="white" stroke-width="2" opacity="0.6"/>
  <line x1="580" y1="110" x2="620" y2="130" stroke="white" stroke-width="2" opacity="0.6"/>
  
  <!-- Central icon -->
  <circle cx="400" cy="200" r="60" fill="url(#people)" opacity="0.9"/>
  <text x="400" y="210" font-family="Arial, sans-serif" font-size="40" text-anchor="middle" fill="#10b981">🤝</text>
  
  <!-- Title -->
  <text x="400" y="320" font-family="Inter, sans-serif" font-size="32" font-weight="bold" text-anchor="middle" fill="white">Developer Culture</text>
  <text x="400" y="350" font-family="Inter, sans-serif" font-size="18" text-anchor="middle" fill="white" opacity="0.9">Building Positive Teams</text>
  
  <!-- Decorative elements -->
  <circle cx="150" cy="300" r="3" fill="white" opacity="0.6"/>
  <circle cx="650" cy="100" r="2" fill="white" opacity="0.4"/>
  <circle cx="200" cy="50" r="2" fill="white" opacity="0.5"/>
  <circle cx="600" cy="350" r="3" fill="white" opacity="0.6"/>
</svg>
