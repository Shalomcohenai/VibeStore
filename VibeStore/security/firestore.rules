rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthed() && (request.auth.token.admin == true || request.auth.token.email == 'shalom.cohen.111@gmail.com');
    }

    // Allow reading apps collection for listing (filtered by individual document rules)
    match /apps {
      allow read: if true; // Individual document permissions still apply
    }

    // Allow reading approved/published/active apps to everyone, all apps to admin
    match /apps/{appId} {
      allow read: if true; // Allow reading all apps for now

      // Create new app as 'pending' by registered users only
      // DEV MODE: Relaxed validation - only title required
      allow create: if isAuthed()
        && request.resource.data.status == 'pending'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;

      // Only admin can update/delete apps, but allow users to update likes counter and rating aggregates
      allow update: if isAdmin() || 
        (isAuthed() && 
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes_count', 'updatedAt']) &&
          request.resource.data.likes_count is int &&
          request.resource.data.likes_count >= 0) ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating_count', 'rating_sum', 'rating_avg', 'updatedAt']) &&
          request.resource.data.rating_count is int &&
          request.resource.data.rating_count >= 0 &&
          request.resource.data.rating_sum is int &&
          request.resource.data.rating_sum >= 0 &&
          request.resource.data.rating_avg is number &&
          request.resource.data.rating_avg >= 0 &&
          request.resource.data.rating_avg <= 5));
      allow delete: if isAdmin();
    }

    // Reviews: allow creation only if user has verified interaction (clicked on app)
    match /reviews/{reviewId} {
      allow read: if true;
      allow list: if true; // Allow listing for stats
      allow create: if isAuthed()
        && request.resource.data.appId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string
        && exists(/databases/$(database)/documents/interactions/$(request.auth.uid + '_' + request.resource.data.appId));
      allow update, delete: if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
    }

    // Promotions (Stripe webhook writes)
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin(); // Or restrict to webhook via callable/admin flow
    }

    // Blog posts - read for everyone, write for admins
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blog comments - read for everyone, write for authenticated users
    match /blog_comments/{commentId} {
      allow read: if true;
      allow create: if isAuthed() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && request.resource.data.blogId is string;
      allow update, delete: if isAdmin() || 
        (isAuthed() && resource.data.userId == request.auth.uid);
    }

    // Blog categories - read for everyone, write for admins
    match /blog_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Newsletter subscriptions - create for everyone, read for admins
    match /newsletter_subscriptions/{subscriptionId} {
      allow create: if true; // Anyone can subscribe
      allow read: if isAdmin(); // Admin can read all
      allow list: if isAdmin(); // Admin can list all
      allow update, delete: if isAdmin();
    }
    
    // Reports - create for authenticated users, read for admins
    match /reports/{reportId} {
      allow create: if isAuthed() 
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000;
      allow read: if isAdmin();
      allow list: if isAdmin(); // Admin can list all
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Allow admin to read users collection for statistics
    match /users/{uid} {
      allow read, write: if isAuthed() && request.auth.uid == uid;
      allow list: if isAdmin(); // Admin can list all users for stats
      
      // Allow creating user document with proper structure
      allow create: if isAuthed() 
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.favorites is list
        && request.resource.data.lists is list
        && request.resource.data.createdAt is timestamp;
        
      // Allow updating user data with proper validation
      allow update: if isAuthed() 
        && request.auth.uid == uid
        && (request.resource.data.favorites is list || !('favorites' in request.resource.data.diff(resource.data).affectedKeys()))
        && (request.resource.data.lists is list || !('lists' in request.resource.data.diff(resource.data).affectedKeys()))
        && (request.resource.data.updatedAt is timestamp || !('updatedAt' in request.resource.data.diff(resource.data).affectedKeys()));
    }
    
    // Allow admin to list interactions for statistics
    match /interactions/{id} {
      allow read: if isAuthed() && request.auth.uid == id.split('_')[0];
      allow list: if isAdmin(); // Admin can list all for stats
      allow write: if isAuthed();
    }
  }
}
